digraph ERD { graph [rankdir=LR,bgcolor="white",pad="0.3",nodesep="0.6",ranksep="0.9",splines=ortho]; node [shape=plain,fontname="Arial"]; edge [fontname="Arial",fontsize=10,color="#6B7280",penwidth=1.3,dir=both,arrowtail=none,arrowhead=none];
usuarios [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>USUARIOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id INT</TD></TR><TR><TD ALIGN="LEFT">nome VARCHAR(120)</TD></TR><TR><TD ALIGN="LEFT">email VARCHAR(160) UNIQUE</TD></TR><TR><TD ALIGN="LEFT">senha_hash VARCHAR(255)</TD></TR><TR><TD ALIGN="LEFT">perfil ENUM</TD></TR><TR><TD ALIGN="LEFT">criado_em DATETIME</TD></TR></TABLE> >];
categorias [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>CATEGORIAS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id INT</TD></TR><TR><TD ALIGN="LEFT">nome VARCHAR(80) UNIQUE</TD></TR><TR><TD ALIGN="LEFT">descricao VARCHAR(255)</TD></TR></TABLE> >];
chamados [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>CHAMADOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id INT</TD></TR><TR><TD ALIGN="LEFT">numero VARCHAR(30) UNIQUE</TD></TR><TR><TD ALIGN="LEFT">assunto VARCHAR(150)</TD></TR><TR><TD ALIGN="LEFT">descricao TEXT</TD></TR><TR><TD ALIGN="LEFT">prioridade ENUM</TD></TR><TR><TD ALIGN="LEFT">status ENUM</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> solicitante_id → usuarios.id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> categoria_id → categorias.id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> tecnico_id → usuarios.id (NULL)</TD></TR><TR><TD ALIGN="LEFT">data_abertura DATETIME(3)</TD></TR></TABLE> >];
historico [label=< <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#7C3AED"><FONT COLOR="white"><B>HISTORICO_ATENDIMENTOS</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B> id INT</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> chamado_id → chamados.id</TD></TR><TR><TD ALIGN="LEFT"><B>FK</B> tecnico_id → usuarios.id</TD></TR><TR><TD ALIGN="LEFT">data_atendimento DATETIME(3)</TD></TR><TR><TD ALIGN="LEFT">observacao TEXT</TD></TR><TR><TD ALIGN="LEFT">solucao TEXT NULL</TD></TR><TR><TD ALIGN="LEFT">status_resultante ENUM</TD></TR></TABLE> >];
usuarios -> chamados [taillabel="1",headlabel="N",label=" solicitante abre ",labeldistance=2]; categorias -> chamados [taillabel="1",headlabel="N",label=" classifica ",labeldistance=2]; usuarios -> chamados [taillabel="0..1",headlabel="N",label=" técnico responsável ",labeldistance=2,constraint=false]; chamados -> historico [taillabel="1",headlabel="N",label=" possui ",labeldistance=2]; usuarios -> historico [taillabel="1",headlabel="N",label=" registra ",labeldistance=2,constraint=false]; }